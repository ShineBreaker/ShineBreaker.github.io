---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { postSlug } from '../../utils/post';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((entry, index) => ({
    params: { slug: postSlug(entry) },
    props: { entry, prev: posts[index - 1], next: posts[index + 1] },
  }));
}

const { entry, prev, next } = Astro.props as {
  entry: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
};
---

<BaseLayout title={entry.data.title} description={entry.data.description} pageClass="post" type="article">
  <PostLayout entry={entry} prev={prev} next={next} />
</BaseLayout>
