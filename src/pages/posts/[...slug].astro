---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import { postSlug } from '../../utils/post';
import { sortPosts } from '../../utils/pagination';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts'));
  return posts.map((entry, index) => ({
    params: { slug: postSlug(entry) },
    props: { entry, prev: posts[index - 1], next: posts[index + 1] },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, prev, next } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.description} pageClass="post" type="article">
  <PostLayout entry={entry} prev={prev} next={next} />
</BaseLayout>
