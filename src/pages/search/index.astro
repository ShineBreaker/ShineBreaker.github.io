---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="search" pageClass="search">
  <section class="search-page" aria-labelledby="search-title" data-search-root>
    <header class="listing__header">
      <p class="eyebrow">rg --ignore-case --glob '*.md'</p>
      <h1 id="search-title">SEARCH</h1>
      <p>输入关键词以检索文章与已允许索引的独立页面。</p>
    </header>
    <label class="search-box" for="site-search">
      <span aria-hidden="true">$</span>
      <input id="site-search" type="search" autocomplete="off" placeholder="搜索文章…" data-search-input />
    </label>
    <p class="search-status" role="status" data-search-status>请输入关键词。</p>
    <ol class="search-results" data-search-results></ol>
  </section>
</BaseLayout>
