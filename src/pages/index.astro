---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { PAGE_SIZE, sortPosts, pageCount } from '../utils/pagination';

const posts = sortPosts(await getCollection('posts'));
const lastPage = pageCount(posts.length);
const pagePosts = posts.slice(0, PAGE_SIZE);
---

<BaseLayout pageClass="index">
  <PostList posts={pagePosts} pageNum={1} lastPage={lastPage} />
</BaseLayout>
