---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TaxonomyIndex from '../../components/TaxonomyIndex.astro';
import { getCollection } from 'astro:content';
import { aggregate } from '../../utils/taxonomy';

const posts = await getCollection('posts');
const tags = aggregate(posts, 'tags');
---

<BaseLayout title="tags" pageClass="tags">
  <TaxonomyIndex items={[...tags.values()]} heading="TAG INDEX" detail="按主题检索所有记录" path="tags" />
</BaseLayout>
