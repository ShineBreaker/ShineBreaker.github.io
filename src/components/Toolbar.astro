---
import { MENU, PALETTE, SITE } from '../consts';

const defaultScheme = PALETTE.schemes.find((scheme) => scheme.id === PALETTE.default) ?? PALETTE.schemes[0];
const isExternal = (href: string): boolean => /^https?:\/\//.test(href);
---

<header class="site-toolbar" data-toolbar>
  <nav class="toolbar-shell" aria-label="主导航">
    <a class="toolbar-brand" href="/" aria-label={`${SITE.title} 首页`}>[ {SITE.title.toUpperCase()} ]</a>
    <div class="toolbar-links" aria-label="站点链接">
      {
        MENU.map((item, index) => (
          <a
            class={`toolbar-link ${index > 3 ? 'toolbar-link--secondary' : ''}`}
            href={item.href}
            {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            [{item.label.charAt(0).toUpperCase()}]
            <span>{item.label.toUpperCase()}</span>
          </a>
        ))
      }
    </div>
    <div class="toolbar-actions">
      <a class="toolbar-action" href="/search/" aria-label="搜索">[/]</a>
      <button class="toolbar-action toolbar-palette-trigger" type="button" popovertarget="palette-menu" aria-controls="palette-menu" aria-label="切换配色">
        <span data-current-palette-name>{defaultScheme?.name}</span>
      </button>
      <button class="toolbar-action" type="button" data-globe-toggle aria-pressed="false" aria-label="暂停 ASCII 地球">[||]</button>
    </div>
    <div id="palette-menu" class="palette-menu" popover data-palette-menu aria-label="选择配色">
      <p class="palette-menu__title">BASE16 // SELECT</p>
      {
        PALETTE.schemes.map((scheme) => (
          <button
            type="button"
            class="palette-option"
            aria-label={scheme.name}
            data-palette-option
            data-palette-id={scheme.id}
            data-palette-name={scheme.name}
            data-palette-variant={scheme.variant}
          >
            {scheme.name}
          </button>
        ))
      }
    </div>
  </nav>
</header>
