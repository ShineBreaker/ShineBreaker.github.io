---
import Head from '../components/Head.astro';
import Toolbar from '../components/Toolbar.astro';
import Footer from '../components/Footer.astro';
import AsciiGlobe from '../components/AsciiGlobe.astro';
import ContentLicense from '../components/ContentLicense.astro';
import { GLOBE, PALETTE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  type?: 'website' | 'article';
  showGlobe?: boolean;
}

const { title, description, pageClass = 'index', type = 'website' } = Astro.props;
// 文章页自带 article 模式的大 globe 背景，右下角 corner globe 仅在非文章页显示（对齐原主题 !is_post() 行为）。
const showGlobe = pageClass !== 'post' && GLOBE.enabled;
---

<!doctype html>
<html lang="zh-CN" data-site-root="/" data-palette={PALETTE.default}>
  <head>
    <Head title={title} description={description} type={type} />
  </head>
  <body class={`site-page site-page--${pageClass}`}>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <Toolbar />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    {showGlobe && <AsciiGlobe mode="corner" />}
    <ContentLicense />
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
